# /etc/smartbrain-library/env  (root:sblibrary, mode 640). Never commit the real file.
LIBRARY_BIND=172.17.0.1
LIBRARY_DB=/var/lib/smartbrain-library/queue.sqlite3
LIBRARY_MANIFEST=/etc/smartbrain-library/manifest.json
LIBRARY_TRUSTED_PROXIES=172.16.0.0/12
# openssl rand -hex 32; the same value goes in LIBRARY_ADMIN_TOKEN on the machine that runs `sourcetool ingest`
LIBRARY_ADMIN_TOKEN=
